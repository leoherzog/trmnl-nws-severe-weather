<script>
(function () {
  var locale = '{{ trmnl.user.locale }}' || undefined;
  var timeZone = '{{ trmnl.user.time_zone_iana }}' || undefined;
  var hour12 = {{ hour12 }};
  function formatter(opts) {
    opts.hour12 = hour12;
    try {
      return new Intl.DateTimeFormat(locale, Object.assign({ timeZone: timeZone }, opts));
    } catch (e) {
      {%- comment -%} Invalid locale or timezone: fall back to render-environment defaults {%- endcomment -%}
      return new Intl.DateTimeFormat(undefined, opts);
    }
  }
  var formats = {
    time: formatter({ hour: 'numeric', minute: '2-digit' }),
    datetime: formatter({ month: 'numeric', day: 'numeric', hour: 'numeric', minute: '2-digit' })
  };
  document.querySelectorAll('[data-dt]').forEach(function (el) {
    var seconds = parseInt(el.getAttribute('data-dt'), 10);
    if (!seconds) return;
    var format = formats[el.getAttribute('data-dt-style')] || formats.datetime;
    el.textContent = format.format(new Date(seconds * 1000));
  });
})();

(function () {
  {%- comment -%}
  NWS hard-wraps prose at ~70 chars: single newlines are line wrapping, blank
  lines separate paragraphs ("* WHAT...", "* WHERE...", the appended
  instruction). Liquid emits the raw text; here we collapse wrap-newlines and
  rebuild paragraph breaks as <br> so each bullet starts on its own line.
  Runs before the measurement script below, which sees the reflowed heights.
  {%- endcomment -%}
  document.querySelectorAll('.description[data-clamp]').forEach(function (el) {
    var text = el.textContent.trim();
    if (text.indexOf('\n') === -1) return;
    var paragraphs = text.split(/\s*\n\s*\n\s*/);
    el.textContent = '';
    paragraphs.forEach(function (p, i) {
      if (i) el.appendChild(document.createElement('br'));
      el.appendChild(document.createTextNode(p.replace(/\s*\n\s*/g, ' ')));
    });
  });
})();

(function () {
  {%- comment -%}
  Grow description clamps into leftover space. Inline scripts run before the
  framework clamp engine reads data-clamp, so we can raise the line budgets it
  will apply. Priority: every alert visible at its baseline clamp first —
  expansion only distributes the pixels left over after that, one line at a
  time round-robin, so a long alert can never push a later alert into the
  overflow engine's "and N more". The height budget comes from the viewport
  (the render browser is sized to the actual screen/slot), not from container
  heights, which stretch with content. If anything fails, baseline applies.
  {%- endcomment -%}
  var container = document.querySelector('[data-overflow]');
  if (!container) return;
  var column = container.querySelector('.column');
  var descs = Array.prototype.slice.call(container.querySelectorAll('.description[data-clamp]'));
  if (!column || !descs.length) return;

  {%- comment -%}
  True vertical budget: from the top of the list to the bottom of the .layout
  content box. The framework gives .layout a fixed CSS height per view type
  (.view--quadrant .layout:has(+.title_bar) = quadrant-h - title bar, etc.),
  so it is safe to measure. The viewport is NOT: the render browser is always
  the full screen (800x480 / 1040x780), even for a quadrant or half view, so
  budgeting off clientHeight over-expanded small layouts until the only item
  no longer fit and the overflow engine hid it behind "and 1 more".
  {%- endcomment -%}
  var containerTop = container.getBoundingClientRect().top;
  var layout = container.closest('.layout');
  var available;
  if (layout) {
    var layoutStyle = getComputedStyle(layout);
    available = layout.getBoundingClientRect().bottom
      - (parseFloat(layoutStyle.paddingBottom) || 0)
      - containerTop
      - 4;
  } else {
    var bar = document.querySelector('.title_bar');
    available = document.documentElement.clientHeight
      - containerTop
      - (bar ? bar.offsetHeight : 0)
      - 24;
  }
  if (available <= 0) return;

  {%- comment -%} Per-description metrics: line height, natural (unclamped) lines, baseline lines {%- endcomment -%}
  var lineHs = [], naturalLines = [], baseLines = [];
  descs.forEach(function (el) {
    var style = getComputedStyle(el);
    var lineH = parseFloat(style.lineHeight) || (parseFloat(style.fontSize) * 1.4) || 20;
    var base = parseInt(el.getAttribute('data-clamp'), 10) || 2;
    ['-sm', '-md', '-lg', '-portrait', '-md-portrait'].forEach(function (suffix) {
      var v = parseInt(el.getAttribute('data-clamp' + suffix), 10);
      if (v > base) base = v;
    });
    lineHs.push(lineH);
    naturalLines.push(Math.ceil(el.offsetHeight / lineH));
    baseLines.push(base);
  });

  {%- comment -%} Height of all content with every description at its baseline clamp {%- endcomment -%}
  var children = Array.prototype.slice.call(column.children);
  var contentPx = 0;
  children.forEach(function (c) { contentPx += c.offsetHeight; });
  var rowGap = parseFloat(getComputedStyle(column).rowGap) || 0;
  contentPx += rowGap * Math.max(0, children.length - 1);
  descs.forEach(function (el, i) {
    var shownLines = Math.min(naturalLines[i], baseLines[i]);
    contentPx -= el.offsetHeight - shownLines * lineHs[i];
  });

  {%- comment -%} Round-robin: reveal one more line at a time while free pixels remain {%- endcomment -%}
  var freePx = available - contentPx;
  var extra = descs.map(function () { return 0; });
  var progress = true, guard = 0;
  while (progress && guard++ < 500) {
    progress = false;
    descs.forEach(function (el, i) {
      if (freePx >= lineHs[i] && baseLines[i] + extra[i] < naturalLines[i]) {
        extra[i]++;
        freePx -= lineHs[i];
        progress = true;
      }
    });
  }

  descs.forEach(function (el, i) {
    if (!extra[i]) return;
    ['', '-sm', '-md', '-lg', '-portrait', '-md-portrait'].forEach(function (suffix) {
      var name = 'data-clamp' + suffix;
      var v = parseInt(el.getAttribute(name), 10);
      if (v) el.setAttribute(name, String(v + extra[i]));
    });
  });
})();
</script>
{% endtemplate %}

{% template alert_item %}
{%- comment -%}
Renders a single NWS alert card.
Parameters:
- alert: a feature object from the NWS GeoJSON features array
- date_style: Intl format style for the onset–end range ('time' for active, 'datetime' for upcoming)
{%- endcomment -%}
{% assign end_raw = alert.properties.ends | default: alert.properties.expires %}
<div class="item">
  <div class="meta"></div>
  <div class="content">
    <div class="flex flex--row flex--center-y">
      <span class="title title--small lg:title--base">{{ alert.properties.event }}</span>
      <span class="label label--small label--inverted 4bit:label--outline">
        {{ alert.properties.severity }}
      </span>
    </div>
    {%- comment -%}
    Raw NWS newlines are emitted as-is (instruction appended after a blank
    line); the paragraph-normalization script in `main` reads them from
    textContent and rebuilds the block with real line breaks.
    {%- endcomment -%}
    <span class="description lg:description--large" data-clamp="2" data-clamp-lg="3">{{ alert.properties.description | strip }}{% if alert.properties.instruction and alert.properties.instruction != '' %}

{{ alert.properties.instruction | strip }}{% endif %}</span>
    <div class="flex gap--small">
      <span class="label label--small label--underline">
        <span data-dt="{{ alert.properties.onset | date: '%s' }}" data-dt-style="{{ date_style }}"></span>
        –
        <span data-dt="{{ end_raw | date: '%s' }}" data-dt-style="{{ date_style }}"></span>
      </span>
    </div>
  </div>
</div>
{% endtemplate %}
