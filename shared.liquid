{% template main %}
{% if trmnl.plugin_settings.custom_fields_values.timemode == '24_hour' %}
{% assign mask_time = '%H:%M' %}
{% assign mask_datetime = '%-m/%-d %H:%M' %}
{% else %}
{% assign mask_time = '%-I:%M%P' %}
{% assign mask_datetime = '%-m/%-d %-I:%M%P' %}
{% endif %}

{% assign now_local = trmnl.system.timestamp_utc
| plus: trmnl.user.utc_offset %}
{% assign include_future = trmnl.plugin_settings.custom_fields_values.includefuture == 'true' %}
{% assign updated_iso = updated | date: "%s" | plus: trmnl.user.utc_offset | date: "%Y-%m-%dT%H:%M:%S%z" %}

{% assign active_count = 0 %}
{% assign upcoming_count = 0 %}
{% for alert in features %}
  {% assign onset_local = alert.properties.onset | date: "%s" | plus: trmnl.user.utc_offset %}
  {% assign end_raw = alert.properties.ends | default: alert.properties.expires %}
  {% assign ends_local = end_raw | date: "%s" | plus: trmnl.user.utc_offset %}
  {% if now_local >= onset_local and now_local <= ends_local %}
    {% assign active_count = active_count | plus: 1 %}
  {% elsif onset_local > now_local %}
    {% assign upcoming_count = upcoming_count | plus: 1 %}
  {% endif %}
{% endfor %}

{% assign show_upcoming = false %}
{% if include_future and upcoming_count > 0 %}
  {% assign show_upcoming = true %}
{% endif %}


{% if active_count == 0 and show_upcoming == false %}
{%- comment -%} Empty state: no alerts to display {%- endcomment -%}
<div class="layout layout--center">
  <span class="label label--gray lg:label--xlarge text--center">No Active{% if trmnl.plugin_settings.custom_fields_values.includefuture == 'true' %} or Upcoming{% endif %}<br>Severe Weather Alerts</span>
</div>

{% else %}
<div class="layout">
  <div class="columns h--full" data-overflow="true" data-overflow-max-cols="1" data-overflow-max-cols-lg="2" data-overflow-max-cols-portrait="1" data-overflow-counter="true">
    <div class="column">

      {%- comment -%} ACTIVE alerts: onset ≤ now ≤ ends {%- endcomment -%}
      {% if active_count > 0 %}
        <span class="label lg:label--large">Active</span>

        {% for alert in features %}
        {% assign onset_local = alert.properties.onset | date: "%s" | plus: trmnl.user.utc_offset %}
        {% assign end_raw = alert.properties.ends | default: alert.properties.expires %}
        {% assign ends_local = end_raw | date: "%s" | plus: trmnl.user.utc_offset %}
        {% if now_local >= onset_local and now_local <= ends_local %}
          {% render 'alert_item', alert: alert, date_mask: mask_time %}
        {% endif %}
        {% endfor %}
      {% endif %}

      {%- comment -%} UPCOMING alerts: onset > now {%- endcomment -%}
      {% if show_upcoming %}
        <span class="label lg:label--large">Upcoming</span>

        {% for alert in features %}
        {% assign onset_local = alert.properties.onset | date: "%s" | plus: trmnl.user.utc_offset %}
        {% if onset_local > now_local %}
          {% render 'alert_item', alert: alert, date_mask: mask_datetime %}
        {% endif %}
        {% endfor %}
      {% endif %}

    </div>
  </div>
</div>
{% endif %}

<div class="title_bar">
  <img class="image" src="data:image/png;base64,">
  {% if layout_style == 'full' or layout_style == 'half-horizontal' %}
  <span class="title">{{ trmnl.plugin_settings.instance_name }}</span>
  {% endif %}
  {% if updated %}
  <span class="instance">
    Updated {{ updated_iso | l_date: mask_datetime, trmnl.user.locale }}
  </span>
  {% endif %}
</div>
{% endtemplate %}

{% template alert_item %}
{%- comment -%}
Renders a single NWS alert card.
Parameters:
- alert: a feature object from the NWS GeoJSON features array
- date_mask: l_date mask used for the onset–end time range (mask_time for active, mask_datetime for upcoming)
{%- endcomment -%}
{% assign end_raw = alert.properties.ends | default: alert.properties.expires %}
<div class="item">
  <div class="meta"></div>
  <div class="content">
    <div class="flex flex--row flex--center-y">
      <span class="title title--small lg:title--base">{{ alert.properties.event }}</span>
      <span class="label label--small label--inverted 4bit:label--outline">
        {{ alert.properties.severity }}
      </span>
    </div>
    <span class="description lg:description--large" data-clamp="2" data-clamp-lg="3">
      {{ alert.properties.description }}
    </span>
    <div class="flex gap--small">
      <span class="label label--small label--underline">
        {{ alert.properties.onset | l_date: date_mask, trmnl.user.locale }}
        –
        {{ end_raw | l_date: date_mask, trmnl.user.locale }}
      </span>
    </div>
  </div>
</div>
{% endtemplate %}
