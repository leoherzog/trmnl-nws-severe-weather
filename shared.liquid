{% template main %}
{% if trmnl.plugin_settings.custom_fields_values.timemode == '24_hour' %}
{% assign hour12 = 'false' %}
{% else %}
{% assign hour12 = 'true' %}
{% endif %}

{% assign now = trmnl.system.timestamp_utc | plus: 0 %}
{%- comment -%} assign drops a trailing comparison and keeps the raw string, so the boolean is set inside an if {%- endcomment -%}
{% assign include_future = false %}
{% if trmnl.plugin_settings.custom_fields_values.includefuture == 'true' %}
{% assign include_future = true %}
{% endif %}

{% assign active_count = 0 %}
{% assign upcoming_count = 0 %}
{% for alert in features %}
  {% assign onset_ts = alert.properties.onset | date: "%s" | plus: 0 %}
  {% assign end_raw = alert.properties.ends | default: alert.properties.expires %}
  {% assign ends_ts = end_raw | date: "%s" | plus: 0 %}
  {% if now >= onset_ts and now <= ends_ts %}
    {% assign active_count = active_count | plus: 1 %}
  {% elsif onset_ts > now %}
    {% assign upcoming_count = upcoming_count | plus: 1 %}
  {% endif %}
{% endfor %}

{% assign show_upcoming = false %}
{% if include_future and upcoming_count > 0 %}
  {% assign show_upcoming = true %}
{% endif %}



{% if active_count == 0 and show_upcoming == false %}
{%- comment -%} Empty state: no alerts to display {%- endcomment -%}
<div class="layout layout--center">
  <span class="label label--gray lg:label--xlarge text--center">No Active{% if include_future %} or Upcoming{% endif %}<br>Severe Weather Alerts</span>
</div>

{% else %}
<div class="layout">
  <div class="columns h--full" data-overflow="true" data-overflow-max-cols="1" data-overflow-max-cols-lg="2" data-overflow-max-cols-portrait="1" data-overflow-counter="true">
    <div class="column">

      {%- comment -%} ACTIVE alerts: onset ≤ now ≤ ends {%- endcomment -%}
      {% if active_count > 0 %}
        <span class="label lg:label--large">Active</span>

        {% for alert in features %}
        {% assign onset_ts = alert.properties.onset | date: "%s" | plus: 0 %}
        {% assign end_raw = alert.properties.ends | default: alert.properties.expires %}
        {% assign ends_ts = end_raw | date: "%s" | plus: 0 %}
        {% if now >= onset_ts and now <= ends_ts %}
          {% render 'alert_item', alert: alert, date_style: 'time' %}
        {% endif %}
        {% endfor %}
      {% endif %}

      {%- comment -%} UPCOMING alerts: onset > now {%- endcomment -%}
      {% if show_upcoming %}
        <span class="label lg:label--large">Upcoming</span>

        {% for alert in features %}
        {% assign onset_ts = alert.properties.onset | date: "%s" | plus: 0 %}
        {% if onset_ts > now %}
          {% render 'alert_item', alert: alert, date_style: 'datetime' %}
        {% endif %}
        {% endfor %}
      {% endif %}

    </div>
  </div>
</div>
{% endif %}

